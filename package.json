{
  "name": "oh-my-tui",
  "version": "0.1.0",
  "description": "Modular UI enhancements for native Pi, preserving the original agent.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minkhoaa/oh-my-tui.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "tui",
    "terminal"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "extensions/omt/**/*.ts",
    "extensions/omt/backgrounds/catalog.json",
    "extensions/omt/backgrounds/*.rgba.gz",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/omt/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "bench": "node --experimental-strip-types test/benchmark.ts",
    "verify": "npm run typecheck && npm test",
    "test:package": "node --experimental-strip-types --test test/package.test.ts",
    "prepublishOnly": "npm run verify",
    "pi:dev": "pi -e ./extensions/omt/index.ts",
    "capture": "node scripts/capture-screens.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "chafa-wasm": "0.3.3"
  }
}
